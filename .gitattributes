# Normalize text files
* text=auto
*.m text eol=lf
*.md text eol=lf
*.tex text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.py text eol=lf
*.c text eol=lf
*.h text eol=lf
*.tc text eol=lf
*.th text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.css text eol=lf
*.js text eol=lf
*.svg text eol=lf
*.bib text eol=lf
*.mak text eol=lf
Makefile text eol=lf

# Treat report/data assets as binary
*.pdf binary
*.docx binary
*.png binary
*.jpg binary
*.jpeg binary
*.mat binary
*.fig binary
*.p binary
*.mex* binary
